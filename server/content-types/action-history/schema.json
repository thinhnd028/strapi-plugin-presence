{
  "kind": "collectionType",
  "collectionName": "action_histories",
  "info": {
    "singularName": "action-history",
    "pluralName": "action-histories",
    "displayName": "Action History",
    "description": "Audit log of user write actions on content"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
"content-manager": {
            "visible": false
        },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "action": {
      "type": "enumeration",
      "enum": [
        "create",
        "update",
        "publish",
        "unpublish",
        "delete",
        "discardDraft",
        "login",
        "logout",
        "email-send"
      ],
      "required": true
    },
    "contentType": {
      "type": "string",
      "required": true
    },
    "targetDocumentId": {
      "type": "string"
    },
    "entryId": {
      "type": "string"
    },
    "user": {
      "type": "json",
      "description": "User who performed the action (admin or API user)"
    },
    "beforeData": {
      "type": "json",
      "description": "Data before change (for update/delete)"
    },
    "afterData": {
      "type": "json",
      "description": "Data after change (for create/update)"
    },
    "filters": {
      "type": "json",
      "description": "Query filters (for find)"
    },
    "resultCount": {
      "type": "integer",
      "description": "Number of results (for find)"
    },
    "source": {
      "type": "enumeration",
      "enum": [
        "admin",
        "api"
      ],
      "default": "admin"
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "published"],
      "description": "Draft vs published context of the action"
    },
    "locale": {
      "type": "string",
      "description": "Locale of the target document (vi, en, ...)"
    },
    "ip": {
      "type": "string",
      "description": "Client IP address"
    },
    "userAgent": {
      "type": "text",
      "description": "Client user-agent string"
    },
    "versionDocumentId": {
      "type": "string",
      "description": "Document ID of linked version snapshot (update/publish)"
    },
    "hasChanges": {
      "type": "boolean",
      "default": true,
      "description": "False if the action was a no-op (payload matched existing state)"
    },
    "changedFields": {
      "type": "json",
      "description": "List of leaf-path field names that actually changed"
    },
    "changedValues": {
      "type": "json",
      "description": "Map of changedField path -> { before, after } scalar/summary values"
    }
  }
}